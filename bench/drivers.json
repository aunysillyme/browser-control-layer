{
  "schemaVersion": 1,
  "verification": "CI_PENDING",
  "browser": {
    "package": "puppeteer",
    "version": "24.16.0",
    "source": "https://github.com/puppeteer/puppeteer",
    "install": "npm install --save-dev puppeteer@24.16.0"
  },
  "drivers": [
    {
      "id": "playwright-mcp",
      "package": "@playwright/mcp",
      "command": "playwright-mcp",
      "cliCommands": [],
      "transport": "mcp",
      "version": "0.0.40",
      "recipeOwnership": false,
      "source": "https://github.com/microsoft/playwright-mcp",
      "variants": [
        {
          "id": "playwright-default",
          "args": [
            "--headless"
          ],
          "profileClass": "driver-persistent"
        },
        {
          "id": "playwright-isolated",
          "args": [
            "--headless",
            "--isolated"
          ],
          "profileClass": "throwaway"
        }
      ],
      "install": "npm install --save-dev @playwright/mcp@0.0.40"
    },
    {
      "id": "chrome-devtools-mcp",
      "package": "chrome-devtools-mcp",
      "command": "chrome-devtools-mcp",
      "cliCommands": [],
      "transport": "mcp",
      "version": "0.8.0",
      "recipeOwnership": false,
      "source": "https://github.com/ChromeDevTools/chrome-devtools-mcp",
      "variants": [
        {
          "id": "chrome-devtools",
          "args": [
            "--headless"
          ],
          "profileClass": "driver-persistent"
        }
      ],
      "install": "npm install --save-dev chrome-devtools-mcp@0.8.0"
    },
    {
      "id": "agent-browser",
      "package": "agent-browser",
      "command": "agent-browser",
      "cliCommands": [
        "agent-browser"
      ],
      "transport": "cli",
      "version": "0.5.0",
      "recipeOwnership": false,
      "source": "https://github.com/vercel-labs/agent-browser",
      "variants": [
        {
          "id": "agent-browser",
          "args": [],
          "profileClass": "throwaway"
        }
      ],
      "install": "npm install --save-dev agent-browser@0.5.0"
    }
  ]
}
